# Copy to .env and fill in. Never commit .env.

# --- Web search (Brave) ---
BRAVE_API_KEY=

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# --- Cost cap (USD/month) ---
MONTHLY_COST_CAP=0.0

# --- Rate limiting ---
REQUESTS_PER_SECOND_PER_DOMAIN=1.0
GLOBAL_CONCURRENCY=8

# --- Timeouts ---
DEFAULT_TIMEOUT_SECONDS=30
PER_STAGE_TIMEOUT_SECONDS=60

# --- Retries ---
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.0

# --- Per-company limits ---
MAX_FETCHES_PER_COMPANY=50
MAX_RESEARCH_TOOL_CALLS_PER_COMPANY=20
MAX_RESEARCH_TOKENS_PER_COMPANY=10000

# --- Paths ---
CACHE_DIR=.cache
DB_PATH=data/career_discovery.db

# --- Logging ---
LOG_LEVEL=INFO
